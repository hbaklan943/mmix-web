{
  "name": "mmix-web",
  "version": "0.1.0",
  "description": "In-browser MMIX IDE powered by WASM builds of MMIXware",
  "private": true,
  "scripts": {
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\build-native.ps1",
    "build:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\build-wasm.ps1",
    "test:wasm": "node tools\\test-wasm.js",
    "test:e2e": "node tools\\browser-test.js",
    "test:e2e:full": "node tools\\browser-test.js full",
    "serve": "node tools\\serve.js"
  }
}
